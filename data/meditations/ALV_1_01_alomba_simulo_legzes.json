    "end_behavior": "fade_out",
    "blocks": [
      {
        "type": "text",
        "content": "Feküdj le kényelmesen...",
        "tone": "soft"
      },
      {
        "type": "pause",
        "duration_ms": 4000
      },
      {
        "type": "text",
        "content": "Hunyd be a szemed, mintha a világ halká vált volna...",
        "tone": "soft"
      },
      {
        "type": "pause",
        "duration_ms": 5000
      },
      {
        "type": "text",
        "content": "Érezd, ahogy a tested súlyával belesüllyed az ágyba...",
        "tone": "soft"
      },
      {
        "type": "pause",
        "duration_ms": 5000
      },
      {
        "type": "text",
        "content": "Semmit sem kell tenned.",
        "tone": "neutral"
      },
      {
        "type": "pause",
        "duration_ms": 2000
      },
      {
        "type": "text",
        "content": "Semmit sem kell akarnod...",
        "tone": "neutral"
      },
      {
        "type": "pause",
        "duration_ms": 3000
      },
      {
        "type": "text",
        "content": "Csak... lélegezni...",
        "tone": "soft"
      },
      {
        "type": "pause",
        "duration_ms": 4000
      },
      {
        "type": "text",
        "content": "A légzésed puha áramlássá szelídül...",
        "tone": "soft"
      },
      {
        "type": "pause",
        "duration_ms": 3000
      },
      {
        "type": "text",
        "content": "Vegyél egy mély, lassú lélegzetet...",
        "tone": "soft"
      },
      {
        "type": "pause",
        "duration_ms": 4000
      },
      {
        "type": "text",
        "content": "Mintha a hajnali pára töltené meg a földet...",
        "tone": "soft"
      },
      {
        "type": "pause",
        "duration_ms": 4000
      },
      {
        "type": "text",
        "content": "Érezd, ahogy szétárad benned a mozdulatlan tisztaság...",
        "tone": "soft"
      },
      {
        "type": "pause",
        "duration_ms": 5000
      },
      {
        "type": "text",
        "content": "Amikor megteltél levegővel, hagyd, hogy a tested megpihenjen...",
        "tone": "neutral"
      },
      {
        "type": "pause",
        "duration_ms": 4000
      },
      {
        "type": "text",
        "content": "a belső üresség halk ölében.",
        "tone": "soft"
      },
      {
        "type": "pause",
        "duration_ms": 10000
      },
      {
        "type": "text",
        "content": "Most, hogy a légzésed kisimult, irányítsd a figyelmed a testedre...",
        "tone": "neutral"
      },
      {
        "type": "pause",
        "duration_ms": 5000
      },
      {
        "type": "text",
        "content": "Érezd a fejed súlyát...",
        "tone": "soft"
      },
      {
        "type": "pause",
        "duration_ms": 4000
      },
      {
        "type": "text",
        "content": "Mint egy kavics, amely megpihen a folyó fenekén.",
        "tone": "soft"
      },
      {
        "type": "pause",
        "duration_ms": 6000
      },
      {
        "type": "text",
        "content": "A homlok ellazul...",
        "tone": "soft"
      },
      {
        "type": "pause",
        "duration_ms": 3000
      },
      {
        "type": "text",
        "content": "A szemek puhán megpihennek...",
        "tone": "soft"
      },
      {
        "type": "pause",
        "duration_ms": 3000
      },
      {
        "type": "text",
        "content": "Az állkapocs elernyed, mint eső után a levelek...",
        "tone": "soft"
      },
      {
        "type": "pause",
        "duration_ms": 6000
      },
      {
        "type": "text",
        "content": "Minden kilégzéssel egyre mélyebbre süllyedsz...",
        "tone": "soft"
      },
      {
        "type": "pause",
        "duration_ms": 4000
      },
      {
        "type": "text",
        "content": "Az ágy puha ölelésébe.",
        "tone": "soft"
      },
      {
        "type": "pause",
        "duration_ms": 10000
      },
      {
        "type": "text",
        "content": "Érzed a vállaidat...",
        "tone": "soft"
      },
      {
        "type": "pause",
        "duration_ms": 3000
      },
      {
        "type": "text",
        "content": "A karok elnehezülnek...",
        "tone": "soft"
      },
      {
        "type": "pause",
        "duration_ms": 3000
      },
      {
        "type": "text",
        "content": "A kezek megpihennek, mintha egy tiszta tó partján heverésznének.",
        "tone": "soft"
      },
      {
        "type": "pause",
        "duration_ms": 6000
      },
      {
        "type": "text",
        "content": "A mellkasod és a hasad lágyan hullámzik a légzéssel...",
        "tone": "soft"
      },
      {
        "type": "pause",
        "duration_ms": 5000
      },
      {
        "type": "text",
        "content": "Semmit sem kell irányítani...",
        "tone": "neutral"
      },
      {
        "type": "pause",
        "duration_ms": 3000
      },
      {
        "type": "text",
        "content": "Csak hagyni, hogy a mozdulat önmaga legyen.",
        "tone": "neutral"
      },
      {
        "type": "pause",
        "duration_ms": 10000
      },
      {
        "type": "text",
        "content": "Vidd a figyelmed a lábaidra...",
        "tone": "soft"
      },
      {
        "type": "pause",
        "duration_ms": 4000
      },
      {
        "type": "text",
        "content": "A combok, térdek, lábszárak, majd a lábfejek mind ellazulnak...",
        "tone": "soft"
      },
      {
        "type": "pause",
        "duration_ms": 5000
      },
      {
        "type": "text",
        "content": "Mintha egy meleg áramlat simítaná őket.",
        "tone": "soft"
      },
      {
        "type": "pause",
        "duration_ms": 8000
      },
      {
        "type": "text",
        "content": "Most, hogy tested átjárta a puhaság...",
        "tone": "soft"
      },
      {
        "type": "pause",
        "duration_ms": 4000
      },
      {
        "type": "text",
        "content": "Engedd, hogy minden forma feloldódjon a láthatatlan ölelésében.",
        "tone": "soft"
      },
      {
        "type": "pause",
        "duration_ms": 10000
      },
      {
        "type": "text",
        "content": "Nem kell tartanod semmit...",
        "tone": "neutral"
      },
      {
        "type": "pause",
        "duration_ms": 3000
      },
      {
        "type": "text",
        "content": "Nem kell figyelned semmit...",
        "tone": "neutral"
      },
      {
        "type": "pause",
        "duration_ms": 3000
      },
      {
        "type": "text",
        "content": "Csak engedd, hogy légy...",
        "tone": "soft"
      },
      {
        "type": "pause",
        "duration_ms": 3000
      },
      {
        "type": "text",
        "content": "És légy önmagad nyugalmában.",
        "tone": "soft"
      },
      {
        "type": "pause",
        "duration_ms": 8000
      },
      {
        "type": "text",
        "content": "Most hagyd, hogy a tested súlyánál fogva...",
        "tone": "soft"
      },
      {
        "type": "pause",
        "duration_ms": 4000
      },
      {
        "type": "text",
        "content": "még mélyebbre süllyedjen a nyugalom térébe.",
        "tone": "soft"
      },
      {
        "type": "pause",
        "duration_ms": 12000
      },
      {
        "type": "text",
        "content": "Ha gondolat érkezik, figyeld meg...",
        "tone": "neutral"
      },
      {
        "type": "pause",
        "duration_ms": 4000
      },
      {
        "type": "text",
        "content": "Majd engedd tovább, mintha felhőt sodorna a szél.",
        "tone": "neutral"
      },
      {
        "type": "pause",
        "duration_ms": 6000
      },
      {
        "type": "text",
        "content": "Nem kell semmit megtartanod...",
        "tone": "neutral"
      },
      {
        "type": "pause",
        "duration_ms": 3000
      },
      {
        "type": "text",
        "content": "Nem kell semmit elengedned...",
        "tone": "neutral"
      },
      {
        "type": "pause",
        "duration_ms": 3000
      },
      {
        "type": "text",
        "content": "Csak engedd, hogy minden önmaga legyen.",
        "tone": "soft"
      },
      {
        "type": "pause",
        "duration_ms": 10000
      },
      {
        "type": "text",
        "content": "Most már nincsen út...",
        "tone": "soft"
      },
      {
        "type": "pause",
        "duration_ms": 3000
      },
      {
        "type": "text",
        "content": "Nincsen cél...",
        "tone": "soft"
      },
      {
        "type": "pause",
        "duration_ms": 3000
      },
      {
        "type": "text",
        "content": "Csak a létezés puha ringása...",
        "tone": "soft"
      },
      {
        "type": "pause",
        "duration_ms": 25000
      },
      {
        "type": "text",
        "content": "És amikor kész vagy...",
        "tone": "soft"
      },
      {
        "type": "pause",
        "duration_ms": 4000
      },
      {
        "type": "text",
        "content": "Átadhatod magad a csendnek, a pihenésnek...",
        "tone": "soft"
      },
      {
        "type": "pause",
        "duration_ms": 5000
      },
      {
        "type": "text",
        "content": "És az édes, mély alvásnak.",
        "tone": "soft"
      },
      {
        "type": "pause",
        "duration_ms": 35000
      }
    ]
  },
  "meditation_mode": "kontemplativ"
}
