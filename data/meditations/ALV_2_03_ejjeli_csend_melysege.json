      },
      {
        "type": "pause",
        "duration_ms": 3000
      },
      {
        "type": "text",
        "content": "A lágy kiáramlást...",
        "tone": "soft"
      },
      {
        "type": "pause",
        "duration_ms": 25000
      },
      {
        "type": "text",
        "content": "Most figyeld meg...",
