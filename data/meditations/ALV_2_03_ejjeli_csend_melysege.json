    "blocks": [
      {
        "type": "text",
        "content": "Helyezkedj el kényelmesen a fekvő helyzetben...",
        "tone": "soft"
      },
      {
        "type": "pause",
        "duration_ms": 5000
      },
      {
        "type": "text",
        "content": "Érezd, ahogy a tested megadja magát a földnek...",
        "tone": "soft"
      },
      {
        "type": "pause",
        "duration_ms": 5000
      },
      {
        "type": "text",
        "content": "Mint egy kő, ami óvatosan megpihen a patak alján.",
        "tone": "soft"
      },
      {
        "type": "pause",
        "duration_ms": 10000
      },
      {
        "type": "text",
        "content": "Nincs hova menni...",
