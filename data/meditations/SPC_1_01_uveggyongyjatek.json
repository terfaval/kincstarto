    "blocks": [
      {
        "type": "text",
        "content": "Hunyd le a szemed...",
        "tone": "soft"
      },
      {
        "type": "pause",
        "duration_ms": 3000
      },
      {
        "type": "text",
        "content": "Lélegezz puhán, mint aki nem akar zavarni semmit.",
        "tone": "soft"
      },
      {
        "type": "pause",
        "duration_ms": 5000
      },
      {
        "type": "text",
        "content": "A világ most kívül marad.",
        "tone": "soft"
      },
      {
        "type": "pause",
        "duration_ms": 4000
      },
      {
        "type": "text",
        "content": "Ez nem a megértés ideje.",
        "tone": "deep"
      },
      {
        "type": "pause",
        "duration_ms": 2500
      },
      {
        "type": "text",
        "content": "Ez a figyelem ideje.",
        "tone": "deep"
      },
      {
        "type": "pause",
        "duration_ms": 10000
      },
      {
        "type": "text",
        "content": "Képzeld el, hogy egyetlen gyöngy vagy a csendben.",
        "tone": "deep"
      },
      {
        "type": "pause",
        "duration_ms": 5000
      },
      {
        "type": "text",
        "content": "Nem mozdulsz.",
        "tone": "deep"
      },
      {
        "type": "pause",
        "duration_ms": 3500
      },
      {
        "type": "text",
        "content": "De rezeg benned a lehetőség.",
        "tone": "deep"
      },
      {
        "type": "pause",
        "duration_ms": 8000
      },
      {
        "type": "text",
        "content": "Belégzés: egy dallam.",
        "tone": "soft"
      },
      {
        "type": "pause",
        "duration_ms": 3500
      },
      {
        "type": "text",
        "content": "Kilégzés: egy kép.",
        "tone": "soft"
      },
      {
        "type": "pause",
        "duration_ms": 3500
      },
      {
        "type": "text",
        "content": "Belégzés: egy ismeret.",
        "tone": "soft"
      },
      {
        "type": "pause",
        "duration_ms": 4500
      },
      {
        "type": "text",
        "content": "Kilégzés: egy érintés.",
        "tone": "soft"
      },
      {
        "type": "pause",
        "duration_ms": 6000
      },
      {
        "type": "text",
        "content": "Hagyd, hogy a tudáselemek előbújjanak.",
        "tone": "neutral"
      },
      {
        "type": "pause",
        "duration_ms": 4000
      },
      {
        "type": "text",
        "content": "Ne hívd őket – hagyd, hogy jöjjenek.",
        "tone": "neutral"
      },
      {
        "type": "pause",
        "duration_ms": 4500
      },
      {
        "type": "text",
        "content": "Mint a vízfelszínen lebegő fényfoltok.",
        "tone": "soft"
      },
      {
        "type": "pause",
        "duration_ms": 10000
      },
      {
        "type": "text",
        "content": "Egy kép mellé odatársul egy másik.",
        "tone": "neutral"
      },
      {
        "type": "pause",
        "duration_ms": 4500
      },
      {
        "type": "text",
        "content": "Egy dallam megérinti egy régi gondolat ritmusát.",
        "tone": "neutral"
      },
      {
        "type": "pause",
        "duration_ms": 5000
      },
      {
        "type": "text",
        "content": "Egy érzés halkan hozzáhajol egy emlékhez.",
        "tone": "neutral"
      },
      {
        "type": "pause",
        "duration_ms": 6500
      },
      {
        "type": "text",
        "content": "Nem keresel.",
        "tone": "deep"
      },
      {
        "type": "pause",
        "duration_ms": 2500
      },
      {
        "type": "text",
        "content": "Csak engeded, hogy a gyöngyök egymásra találjanak.",
        "tone": "deep"
      },
      {
        "type": "pause",
        "duration_ms": 5000
      },
      {
        "type": "text",
        "content": "Ez nem értelmezés.",
        "tone": "deep"
      },
      {
        "type": "pause",
        "duration_ms": 2500
      },
      {
        "type": "text",
        "content": "Ez szövés.",
        "tone": "deep"
      },
      {
        "type": "pause",
        "duration_ms": 3500
      },
      {
        "type": "text",
        "content": "Egy hangtalan nyelv belül.",
        "tone": "deep"
      },
      {
        "type": "pause",
        "duration_ms": 9000
      },
      {
        "type": "text",
        "content": "A tudattartalmak táncolni kezdenek.",
        "tone": "deep"
      },
      {
        "type": "pause",
        "duration_ms": 5000
      },
      {
        "type": "text",
        "content": "Mintha nem külön testek volnának, hanem egy mozdulat darabjai.",
        "tone": "deep"
      },
      {
        "type": "pause",
        "duration_ms": 10000
      },
      {
        "type": "text",
        "content": "Nincs már kezdete.",
        "tone": "deep"
      },
      {
        "type": "pause",
        "duration_ms": 2500
      },
      {
        "type": "text",
        "content": "Nincs célja.",
        "tone": "deep"
      },
      {
        "type": "pause",
        "duration_ms": 4500
      },
      {
        "type": "text",
        "content": "Mint egy rend, ami önmagát rajzolja,",
        "tone": "deep"
      },
      {
        "type": "pause",
        "duration_ms": 2500
      },
      {
        "type": "text",
        "content": "de senki nem tartja a tollat.",
        "tone": "deep"
      },
      {
        "type": "pause",
        "duration_ms": 5000
      },
      {
        "type": "text",
        "content": "Mint egy templom, amit csak belülről látsz.",
        "tone": "deep"
      },
      {
        "type": "pause",
        "duration_ms": 6000
      },
      {
        "type": "text",
        "content": "Figyeld...",
        "tone": "deep"
      },
      {
        "type": "pause",
        "duration_ms": 5000
      },
      {
        "type": "text",
        "content": "Most a figyelem maga a játék.",
        "tone": "deep"
      },
      {
        "type": "pause",
        "duration_ms": 12000
      },
      {
        "type": "text",
        "content": "Semmit nem kell tovább fonni.",
        "tone": "neutral"
      },
      {
        "type": "pause",
        "duration_ms": 4500
      },
      {
        "type": "text",
        "content": "A szövés abbahagyta magát.",
        "tone": "neutral"
      },
      {
        "type": "pause",
        "duration_ms": 5000
      },
      {
        "type": "text",
        "content": "A dolgok most visszatérnek önmagukba –",
        "tone": "neutral"
      },
      {
        "type": "pause",
        "duration_ms": 2500
      },
      {
        "type": "text",
        "content": "mint levelek, mikor nincs több szél.",
        "tone": "soft"
      },
      {
        "type": "pause",
        "duration_ms": 6000
      },
      {
        "type": "text",
        "content": "A forma most lehántódik.",
        "tone": "deep"
      },
      {
        "type": "pause",
        "duration_ms": 4500
      },
      {
        "type": "text",
        "content": "A figyelem nem keres többé –",
        "tone": "deep"
      },
      {
        "type": "pause",
        "duration_ms": 2500
      },
      {
        "type": "text",
        "content": "mert már nem különbözik attól, amit lát.",
        "tone": "deep"
      },
      {
        "type": "pause",
        "duration_ms": 25000
      },
      {
        "type": "text",
        "content": "Most nem te figyelsz.",
        "tone": "deep"
      },
      {
        "type": "pause",
        "duration_ms": 3500
      },
      {
        "type": "text",
        "content": "Most a figyelem önmaga.",
        "tone": "deep"
      },
      {
        "type": "pause",
        "duration_ms": 12000
      },
      {
        "type": "text",
        "content": "A gyöngyök elhalványulnak.",
        "tone": "deep"
      },
      {
        "type": "pause",
        "duration_ms": 4000
      },
      {
        "type": "text",
        "content": "De nem tűnnek el.",
        "tone": "deep"
      },
      {
        "type": "pause",
        "duration_ms": 3000
      },
      {
        "type": "text",
        "content": "Csak már nem fontosak.",
        "tone": "deep"
      },
      {
        "type": "pause",
        "duration_ms": 5000
      },
      {
        "type": "text",
        "content": "A figyelem most figyelmévé válik.",
        "tone": "deep"
      },
      {
        "type": "pause",
        "duration_ms": 5000
      },
      {
        "type": "text",
        "content": "Mint amikor a tükör csak önmaga fényét tükrözi.",
        "tone": "deep"
      },
      {
        "type": "pause",
        "duration_ms": 25000
      },
      {
        "type": "text",
        "content": "A keresés megszűnik.",
        "tone": "deep"
      },
      {
        "type": "pause",
        "duration_ms": 4000
      },
      {
        "type": "text",
        "content": "Nincs már különbség néző és látott között.",
        "tone": "deep"
      },
      {
        "type": "pause",
        "duration_ms": 6000
      },
      {
        "type": "text",
        "content": "A jelenlét teljessége nem mond semmit –",
        "tone": "deep"
      },
      {
        "type": "pause",
        "duration_ms": 12000
      },
      {
        "type": "text",
        "content": "Most nincs út.",
        "tone": "deep"
      },
      {
        "type": "pause",
        "duration_ms": 3000
      },
      {
        "type": "text",
        "content": "Nincs mozdulat.",
        "tone": "deep"
      },
      {
        "type": "pause",
        "duration_ms": 3000
      },
      {
        "type": "text",
        "content": "Nincs irány.",
        "tone": "deep"
      },
      {
        "type": "pause",
        "duration_ms": 5000
      },
      {
        "type": "text",
        "content": "És mégis minden érzék nyitott.",
        "tone": "deep"
      },
      {
        "type": "pause",
        "duration_ms": 5000
      },
      {
        "type": "text",
        "content": "Ez a jelenlét formátlan tere.",
        "tone": "deep"
      },
      {
        "type": "pause",
        "duration_ms": 5000
      },
      {
        "type": "text",
        "content": "Nem kell benne lenni.",
        "tone": "soft"
      },
      {
        "type": "pause",
        "duration_ms": 3000
      },
      {
        "type": "text",
        "content": "Mégis már ott vagy.",
        "tone": "soft"
      },
      {
        "type": "pause",
        "duration_ms": 10000
      },
      {
        "type": "text",
        "content": "Hallgat a zene –",
        "tone": "neutral"
      },
      {
        "type": "pause",
        "duration_ms": 2500
      },
      {
        "type": "text",
        "content": "de ritmusa visszamarad a légzésedben.",
        "tone": "neutral"
      },
      {
        "type": "pause",
        "duration_ms": 5000
      },
      {
        "type": "text",
        "content": "Eltűntek a számok –",
        "tone": "neutral"
      },
      {
        "type": "pause",
        "duration_ms": 2500
      },
      {
        "type": "text",
        "content": "de valami még mindig pontosan van.",
        "tone": "neutral"
      },
      {
        "type": "pause",
        "duration_ms": 5000
      },
      {
        "type": "text",
        "content": "Nem mondanak semmit a szavak –",
        "tone": "neutral"
      },
      {
        "type": "pause",
        "duration_ms": 2500
      },
      {
        "type": "text",
        "content": "de a csend mondatokká feszül.",
        "tone": "neutral"
      },
      {
        "type": "pause",
        "duration_ms": 5500
      },
      {
        "type": "text",
        "content": "Mint mikor a gondolat már nem gondol –",
        "tone": "deep"
      },
      {
        "type": "pause",
        "duration_ms": 2500
      },
      {
        "type": "text",
        "content": "csak rezeg, mint egy visszhang egy másik időből.",
        "tone": "deep"
      },
      {
        "type": "pause",
        "duration_ms": 25000
      },
      {
        "type": "text",
        "content": "Nem tudod, honnan jöttek.",
        "tone": "deep"
      },
      {
        "type": "pause",
        "duration_ms": 3500
      },
      {
        "type": "text",
        "content": "De érzed, hogy benned vannak.",
        "tone": "deep"
      },
      {
        "type": "pause",
        "duration_ms": 10000
      },
      {
        "type": "text",
        "content": "Most pedig...",
        "tone": "soft"
      },
      {
        "type": "pause",
        "duration_ms": 3500
      },
      {
        "type": "text",
        "content": "Engedd, hogy a figyelem újra súlyt kapjon...",
        "tone": "soft"
      },
      {
        "type": "pause",
        "duration_ms": 5000
      },
      {
        "type": "text",
        "content": "Érzékelj... anélkül, hogy nevet adnál.",
        "tone": "neutral"
      },
      {
        "type": "pause",
        "duration_ms": 6000
      },
      {
        "type": "text",
        "content": "A nyakad tartását...",
        "tone": "neutral"
      },
      {
        "type": "pause",
        "duration_ms": 3500
      },
      {
        "type": "text",
        "content": "a kezed melegét...",
        "tone": "neutral"
      },
      {
        "type": "pause",
        "duration_ms": 3500
      },
      {
        "type": "text",
        "content": "a hasad mozgását...",
        "tone": "neutral"
      },
      {
        "type": "pause",
        "duration_ms": 5000
      },
      {
        "type": "text",
        "content": "Ez most nem elválaszt, hanem lehorgonyoz.",
        "tone": "neutral"
      },
      {
        "type": "pause",
        "duration_ms": 5000
      },
      {
        "type": "text",
        "content": "A tér, amiben voltál, most visszacsorog a testbe.",
        "tone": "neutral"
      },
      {
        "type": "pause",
        "duration_ms": 10000
      },
      {
        "type": "text",
        "content": "Lassan vidd vissza a figyelmed a testedhez.",
        "tone": "soft"
      },
      {
        "type": "pause",
        "duration_ms": 5000
      },
      {
        "type": "text",
        "content": "Ujjhegyeidhez, légzésedhez, a jelen pillanathoz.",
        "tone": "soft"
      },
      {
        "type": "pause",
        "duration_ms": 6000
      },
      {
        "type": "text",
        "content": "De már nem ugyanúgy vagy itt.",
        "tone": "neutral"
      },
      {
        "type": "pause",
        "duration_ms": 4500
      },
      {
        "type": "text",
        "content": "Mert valami átrendeződött.",
        "tone": "neutral"
      },
      {
        "type": "pause",
        "duration_ms": 3000
      },
      {
        "type": "text",
        "content": "És ez elég.",
