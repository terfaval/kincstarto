{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["version", "poses"],
  "properties": {
    "version": { "type": "number" },

    "poses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "slug", "display_name", "symmetry", "variations"],
        "properties": {
          "id": { "type": "string" },
          "slug": { "type": "string" },

          "aliases": {
            "type": "array",
            "items": { "type": "string" }
          },

          "display_name": { "type": "string" },

          "category": { "type": "string" },

          "symmetry": {
            "type": "string",
            "enum": ["symmetrical", "asymmetrical"]
          },

          "mirrorable": { "type": "boolean" },

          "default_variation": { "type": "string" },

          "view_hints": {
            "type": "object",
            "properties": {
              "front": { "type": "string" },
              "angled": { "type": "string" }
            }
          },

          "variations": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "pose_mechanics"],
              "properties": {
                "id": { "type": "string" },

                "match_tokens": {
                  "type": "array",
                  "items": { "type": "string" }
                },

                "pose_identity": {
                  "type": "string",
                  "description": "Optional override of display_name for prompt identity"
                },
                "prompt_override": {
                  "type": "string",
                  "description": "Optional manual prompt text override that will be injected directly into the prompt."
                },

                "pose_mechanics": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 5,
                  "items": {
                    "type": "string"
                  },
                  "description": "Primary prompt-driving lines. Must be short, concrete, visual, and positive."
                },

                "critical_relations": {
                  "type": "array",
                  "maxItems": 3,
                  "items": { "type": "string" }
                },

                "visibility_constraints": {
                  "type": "array",
                  "maxItems": 2,
                  "items": { "type": "string" }
                },

                "negative_constraints": {
                  "type": "array",
                  "maxItems": 6,
                  "items": { "type": "string" }
                },

                "view_hints": {
                  "type": "object",
                  "properties": {
                    "front": { "type": "string" },
                    "angled": { "type": "string" }
                  }
                },

                "side_topology": {
                  "type": "object",
                  "properties": {
                    "left_leg_role": {
                      "type": "string",
                      "enum": ["front_leg", "back_leg", "support_leg", "lifted_leg", "neutral"]
                    },
                    "right_leg_role": {
                      "type": "string",
                      "enum": ["front_leg", "back_leg", "support_leg", "lifted_leg", "neutral"]
                    },
                    "left_arm_role": {
                      "type": "string",
                      "enum": ["support_arm", "reaching_arm", "neutral"]
                    },
                    "right_arm_role": {
                      "type": "string",
                      "enum": ["support_arm", "reaching_arm", "neutral"]
                    },
                    "foreground_side": {
                      "type": "string",
                      "enum": ["left", "right", "none"]
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
